      "parameters": {
        "jsCode": "// Loop through all incoming items from the AI Agent\nfor (const item of $input.all()) {\n  try {\n    // Parse the stringified text inside the \"output\" key\n    const parsedData = JSON.parse(item.json.output);\n    \n    // Overwrite the item's json structure with the newly parsed clean data\n    item.json = parsedData;\n  } catch (error) {\n    // If parsing fails, keep the original item and log an error key\n    item.json.error = \"Failed to parse JSON string: \" + error.message;\n  }\n}\n\n// Return the properly formatted data to the next node\nreturn $input.all();"
      },
